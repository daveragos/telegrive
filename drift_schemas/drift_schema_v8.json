    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" TEXT NOT NULL, \"parent_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"message_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NOT NULL, \"trashed_at\" INTEGER NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"manifest_extra\" TEXT NULL, \"starred\" INTEGER NOT NULL DEFAULT 0 CHECK (\"starred\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drive_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drive_files\" (\"id\" TEXT NOT NULL, \"folder_id\" TEXT NULL, \"name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"size\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"modified_at\" INTEGER NOT NULL, \"part_count\" INTEGER NOT NULL DEFAULT 1, \"parts_present\" INTEGER NOT NULL DEFAULT 0, \"starred\" INTEGER NOT NULL DEFAULT 0 CHECK (\"starred\" IN (0, 1)), \"minithumbnail\" TEXT NULL, \"thumbnail_file_id\" INTEGER NULL, \"taken_at\" INTEGER NULL, \"trashed_at\" INTEGER NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), \"manifest_extra\" TEXT NULL, \"duration_seconds\" INTEGER NULL, \"replaced_by\" TEXT NULL, \"adopted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"adopted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "file_parts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"file_parts\" (\"file_id\" TEXT NOT NULL, \"part_index\" INTEGER NOT NULL, \"message_id\" INTEGER NOT NULL UNIQUE, \"td_file_id\" INTEGER NOT NULL, \"size\" INTEGER NOT NULL, PRIMARY KEY (\"file_id\", \"part_index\"));"
        }
      ]
    },
    {
      "name": "transfers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transfers\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"file_id\" TEXT NOT NULL, \"folder_id\" TEXT NULL, \"source_path\" TEXT NULL, \"owns_source\" INTEGER NOT NULL DEFAULT 0 CHECK (\"owns_source\" IN (0, 1)), \"result_path\" TEXT NULL, \"total_bytes\" INTEGER NOT NULL, \"done_bytes\" INTEGER NOT NULL DEFAULT 0, \"part_count\" INTEGER NOT NULL DEFAULT 1, \"completed_parts\" INTEGER NOT NULL DEFAULT 0, \"error\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NULL, \"origin\" TEXT NOT NULL DEFAULT 'manual', \"asset_id\" TEXT NULL, \"taken_at\" INTEGER NULL, \"thumbnail_path\" TEXT NULL, \"save_to\" TEXT NULL, \"save_folder\" TEXT NULL, \"wifi_only\" INTEGER NOT NULL DEFAULT 0 CHECK (\"wifi_only\" IN (0, 1)), \"duration_seconds\" INTEGER NULL, \"replaces_file_id\" TEXT NULL, \"source_chat_id\" INTEGER NULL, \"source_message_id\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
